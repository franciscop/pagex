  "devDependencies": {
    "babel-core": "^6.26.0",
    "babel-jest": "^21.2.0",
    "babel-preset-env": "^1.6.1",
    "oxlint": "^1.89.0",
    "path-to-regexp": "^2.4.0",
    "rollup": "^0.50.0",
    "rollup-plugin-commonjs": "8.3.0",
    "rollup-plugin-node-resolve": "^3.4.0",
    "uglify-es": "^3.1.3"
